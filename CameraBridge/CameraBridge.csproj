<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="LkProc.Net">
      <HintPath>..\reference_dll\SDK_Package\Library\lib\LkProc.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="OpenCvSharp">
      <HintPath>..\reference_dll\SDK_Package\Library\lib\OpenCvSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CopySdkRuntimeFiles" AfterTargets="Build">
    <ItemGroup>
      <SdkRuntimeFiles Include="..\reference_dll\SDK_Package\Library\lib\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SdkRuntimeFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
